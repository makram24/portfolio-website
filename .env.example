# Groq API key for /api/chat (set in Vercel project env as GROQ_API_KEY)
GROQ_API_KEY=your_groq_api_key_here

# Asset base path. Use / for https://makramalmoghrabi.com (domain root).
# Only set a subpath if hosting in a folder, e.g. VITE_BASE_PATH=/test/
# VITE_BASE_PATH=/

# Only on Vercel deploys (loads /_vercel/* scripts). Leave unset on cPanel/Apache.
# VITE_ENABLE_VERCEL_INSIGHTS=true
