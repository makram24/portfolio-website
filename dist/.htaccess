<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb
  AddType application/octet-stream .enc
</IfModule>

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]

  # Serve existing files and prerendered route directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Unknown paths → real 404 (SPA routes are prerendered as /path/index.html)
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html
